<Window x:Class="MiniProjetoCadastroTarefa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiniProjetoCadastroTarefa" 
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        mc:Ignorable="d"
            Title="Principal" WindowStartupLocation="CenterScreen" Height="450" Width="800" Loaded="Window_Loaded">
    <Grid Background="White">
        <DockPanel>
            <StackPanel Margin="0,0,0,10" DockPanel.Dock="Top" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="Cadastro Geral"  />
                </StackPanel>
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="Ferramentas" />

                </StackPanel>
                <StackPanel Margin="550,0,5,0" Orientation="Vertical">
                    <Label Content="Versão 2.0" />

                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="stpRodape" DockPanel.Dock="Bottom" Orientation="Horizontal">
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="Data:" />
                </StackPanel>
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="11/02/2026" x:Name="DataDia" />

                </StackPanel>
                <StackPanel Margin="0,0,5,0" Orientation="Vertical">
                    <Label Content="00:00" x:Name="DataHora"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="10,0,5,0" Orientation="Vertical">
                    </StackPanel>
                    <StackPanel Margin="10,0,5,0" Orientation="Vertical">
                    </StackPanel>
                    <StackPanel Margin="550,0,5,0" Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" >
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <StackPanel Width="120" HorizontalAlignment="Center" VerticalAlignment="Center" >
                            <StackPanel Margin="0,10,0,0" Orientation="Vertical">
                                <Label Content="Cadastro de Tarefa" FontWeight="Bold" />
                            <StackPanel Orientation="Horizontal"  Margin="20,10,0,0" >
                                    

                                    <Button x:Name="btnCadTarefas" 
                                            Width="80" 
                                            Height="80" 
                                            ToolTip="Cadastro de Tarefas" 
                                            Click="btnCadTarefas_Click">
                                    
                                    <iconPacks:PackIconMicrons Kind="Drive" Width="58" Height="58" Foreground="Black"/>
                                </Button>
                            </StackPanel>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal"  Margin="20,10,0,0" >
                                <Button Width="80" Height="80" ToolTip="Sem Efeito">
                                    <iconPacks:PackIconMicrons Kind="Calendar" Width="58" Height="58" Foreground="Black"/>
                                </Button>

                            </StackPanel>
                            <StackPanel Orientation="Horizontal"  Margin="20,10,0,0" >
                                <Button Width="80"  Height="80"  ToolTip="Sem Efeito">
                                    <iconPacks:PackIconMicrons Kind="BoxTickOutline" Width="58" Height="58" Foreground="Black"/>
                                </Button>

                            </StackPanel>
                        </StackPanel>
                        <GroupBox x:Name="grbConfiguracaoFormulario" Width="250" Height="300" >
                            <ComboBox x:Name="cmbFormulario" Margin="10,10,10,10" Width="210" Height="30"  
                                      SelectionChanged="cmbFormulario_SelectionChanged"  />
                        </GroupBox>

                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
